#!/usr/bin/env bash
set -u
export LC_ALL=C

key_path="${JDU_SSH_KEY_PATH:-$HOME/.ssh/jdu-intro-cybersecurity-2026}"
alias_name="${JDU_SSH_ALIAS:-jdu-ubuntu}"
workspace="${JDU_M6_WORKSPACE:-$HOME/jdu-lab/m6}"
known_hosts="${JDU_KNOWN_HOSTS_PATH:-$HOME/.ssh/known_hosts}"
pass_count=0
fail_count=0
temporary_directory=''

pass() { pass_count=$((pass_count + 1)); printf 'PASS      %-14s %s\n' "$1" "$2"; }
fail() { fail_count=$((fail_count + 1)); printf 'FAIL      %-14s %s\n' "$1" "$2"; }
finish() {
  local total=$((pass_count + fail_count))
  printf '\nRESULT    %d / %d items cleared\n' "$pass_count" "$total"
  printf 'PASS      %d\n' "$pass_count"
  printf 'FAIL      %d\n' "$fail_count"
  ((fail_count == 0))
}
cleanup() {
  if [[ -n "$temporary_directory" && -d "$temporary_directory" ]]; then
    rm -rf -- "$temporary_directory"
  fi
}
trap cleanup EXIT

mission="${2:-${1:-}}"
mission="${mission^^}"
if [[ "$mission" != M6 ]]; then
  printf '%s\n' 'Usage: jdu-cloudcheck mission M6' >&2
  exit 2
fi

temporary_directory="$(mktemp -d)"
derived_public_key="$temporary_directory/derived.pub"
negative_private_key="$temporary_directory/unregistered"
negative_config="$temporary_directory/ssh-config"

if [[ -f "$key_path" && "$(stat -c '%a' "$key_path" 2>/dev/null || true)" == 600 ]]; then
  pass M6-LOCAL-01 'Private key exists with mode 600'
else
  fail M6-LOCAL-01 'Private key must exist with mode 600'
fi

if [[ -s "$key_path.pub" ]]; then
  pass M6-LOCAL-02 'Public key exists'
else
  fail M6-LOCAL-02 'Matching public key is missing'
fi

private_fingerprint=''
public_fingerprint=''
if [[ -f "$key_path" ]] && ssh-keygen -y -f "$key_path" > "$derived_public_key" 2>/dev/null; then
  private_fingerprint="$(ssh-keygen -lf "$derived_public_key" 2>/dev/null | awk '{print $2}')"
fi
if [[ -s "$key_path.pub" ]]; then
  public_fingerprint="$(ssh-keygen -lf "$key_path.pub" 2>/dev/null | awk '{print $2}')"
fi
if [[ -n "$private_fingerprint" && "$private_fingerprint" == "$public_fingerprint" ]]; then
  pass M6-LOCAL-03 'Private key and public key are one key pair'
else
  fail M6-LOCAL-03 'Private key and public key do not match'
fi

effective_config="$(ssh -G "$alias_name" 2>/dev/null || true)"
remote_host="$(awk '$1 == "hostname" {print $2; exit}' <<<"$effective_config")"
remote_user="$(awk '$1 == "user" {print $2; exit}' <<<"$effective_config")"
proxy_command="$(sed -n 's/^proxycommand //p' <<<"$effective_config" | head -n 1)"
if [[ -n "$remote_host" && "$remote_user" == ssm-user && "$proxy_command" == *'aws ssm start-session'* ]]; then
  pass M6-LOCAL-04 'SSH alias uses ssm-user and a Session Manager tunnel'
else
  fail M6-LOCAL-04 'Inspect the jdu-ubuntu SSH alias and ProxyCommand'
fi

host_key_known=false
if [[ -n "$remote_host" && -f "$known_hosts" ]] && ssh-keygen -F "$remote_host" -f "$known_hosts" >/dev/null 2>&1; then
  host_key_known=true
fi
if $host_key_known; then pass M6-HOST-01 'Remote host key is recorded in known_hosts'; else fail M6-HOST-01 'Complete the first SSH connection and record the host key'; fi

remote_identity="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias_name" 'printf "%s:%s" "$(id -un)" "$(hostname)"' 2>/dev/null || true)"
if [[ "$remote_identity" == ssm-user:* ]]; then pass M6-AUTH-01 'Registered key authenticates as ssm-user'; else fail M6-AUTH-01 'SSH authentication with the registered key failed'; fi

remote_key_output="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias_name" 'ssh-keygen -lf /etc/jdu-lab/student-ssh-key.pub' 2>/dev/null || true)"
remote_fingerprint="$(awk '{print $2}' <<<"$remote_key_output")"
if [[ -n "$public_fingerprint" && "$remote_fingerprint" == "$public_fingerprint" ]]; then pass M6-AUTH-02 'Local public key matches the key registered on Ubuntu'; else fail M6-AUTH-02 'Local and registered public-key fingerprints differ'; fi

local_source="$workspace/local-source.txt"
local_hash=''
remote_upload_hash=''
if [[ -f "$local_source" ]] && grep -Fqx 'JDU SSH transfer test' "$local_source" && [[ "$(wc -l < "$local_source")" -eq 1 ]]; then
  local_hash="$(sha256sum "$local_source" | awk '{print $1}')"
fi
remote_upload_output="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias_name" 'sha256sum ~/jdu-lab/m6/upload.txt' 2>/dev/null || true)"
remote_upload_hash="$(awk '{print $1}' <<<"$remote_upload_output")"
if [[ -n "$local_hash" && "$remote_upload_hash" == "$local_hash" ]]; then pass M6-XFER-01 'The scp upload matches the CloudShell source'; else fail M6-XFER-01 'Create local-source.txt and transfer it to upload.txt'; fi

downloaded_result="$workspace/downloaded-result.txt"
downloaded_hash=''
remote_result_hash=''
if [[ -f "$downloaded_result" ]]; then downloaded_hash="$(sha256sum "$downloaded_result" | awk '{print $1}')"; fi
remote_result_output="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias_name" 'sha256sum ~/jdu-lab/m6/remote-result.txt' 2>/dev/null || true)"
remote_result_hash="$(awk '{print $1}' <<<"$remote_result_output")"
if [[ -n "$downloaded_hash" && "$remote_result_hash" == "$downloaded_hash" ]]; then pass M6-XFER-02 'The scp download matches the remote result'; else fail M6-XFER-02 'Download remote-result.txt with scp'; fi

negative_ok=false
if [[ -n "$remote_host" && -n "$proxy_command" ]] && ssh-keygen -q -t ed25519 -N '' -f "$negative_private_key"; then
  cat > "$negative_config" <<EOF
Host jdu-m6-unregistered
    HostName $remote_host
    User ssm-user
    IdentityFile $negative_private_key
    IdentitiesOnly yes
    ProxyCommand $proxy_command
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
EOF
  chmod 0600 "$negative_config"
  marker_name=".jdu-unregistered-check-$$"
  ssh -F "$negative_config" -o BatchMode=yes -o ConnectTimeout=15 jdu-m6-unregistered "touch ~/jdu-lab/m6/$marker_name" >/dev/null 2>&1
  negative_exit=$?
  if ((negative_exit == 255)) && ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias_name" "test ! -e ~/jdu-lab/m6/$marker_name" >/dev/null 2>&1; then
    negative_ok=true
  fi
  ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias_name" "rm -f ~/jdu-lab/m6/$marker_name" >/dev/null 2>&1 || true
fi
if $negative_ok; then pass M6-NEG-01 'An unregistered key is rejected without running its command'; else fail M6-NEG-01 'The unregistered-key rejection was not confirmed'; fi

finish
