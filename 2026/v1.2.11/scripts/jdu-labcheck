#!/usr/bin/env bash
set -u
export LC_ALL=C

PASS_COUNT=0
NOT_READY_COUNT=0
FAIL_COUNT=0
ERROR_COUNT=0
student_user="$(id -un)"
student_home="$HOME"

pass() { PASS_COUNT=$((PASS_COUNT + 1)); printf 'PASS      %-14s %s\n' "$1" "$2"; }
not_ready() { NOT_READY_COUNT=$((NOT_READY_COUNT + 1)); printf 'FAIL      %-14s %s\n' "$1" "$2"; }
fail() { FAIL_COUNT=$((FAIL_COUNT + 1)); printf 'FAIL      %-14s %s\n' "$1" "$2"; }
error() { ERROR_COUNT=$((ERROR_COUNT + 1)); printf 'FAIL      %-14s %s\n' "$1" "$2"; }
finish() {
  local failed_total total
  failed_total=$((NOT_READY_COUNT + FAIL_COUNT + ERROR_COUNT))
  total=$((PASS_COUNT + failed_total))
  printf '\nRESULT    %d / %d items cleared\n' "$PASS_COUNT" "$total"
  printf 'PASS      %d\n' "$PASS_COUNT"
  printf 'FAIL      %d\n' "$failed_total"
  if ((ERROR_COUNT > 0)); then exit 2; fi
  if ((NOT_READY_COUNT > 0 || FAIL_COUNT > 0)); then exit 1; fi
  exit 0
}

check_env_field() {
  local check_id="$1" file="$2" key="$3" expected="$4" description="$5" actual
  if [[ ! -f "$file" ]]; then
    fail "$check_id" "$key is not recorded"
    return
  fi
  actual="$(read_env_value "$file" "$key" 2>/dev/null || true)"
  if [[ -z "$actual" ]]; then
    fail "$check_id" "$key is not recorded"
  elif [[ "$actual" == "$expected" ]]; then
    pass "$check_id" "$description"
  else
    fail "$check_id" "$key does not match the live state"
  fi
}

read_env_value() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 1
  sed -n "s/^${key}=//p" "$file" | tail -n 1
}

env_matches() {
  local file="$1"; shift
  local item key expected actual
  [[ -f "$file" ]] || return 2
  for item in "$@"; do
    key="${item%%:*}"
    expected="${item#*:}"
    actual="$(read_env_value "$file" "$key" 2>/dev/null || true)"
    [[ -n "$actual" ]] || return 2
    [[ "$actual" == "$expected" ]] || return 1
  done
  return 0
}

check_env_result() {
  local check_id="$1" file="$2" description="$3"; shift 3
  env_matches "$file" "$@"
  case $? in
    0) pass "$check_id" "$description" ;;
    1) fail "$check_id" 'Evidence does not match the live state' ;;
    2) not_ready "$check_id" "Create $file with every required field" ;;
  esac
}

service_pid() { systemctl show -p MainPID --value "$1" 2>/dev/null || true; }
service_user() {
  local pid="$1"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  ps -o user= -p "$pid" 2>/dev/null | awk '{$1=$1; print}'
}

check_m0() {
  local evidence="$student_home/jdu-lab/m0/observation.env" os_id os_version
  os_id="$(. /etc/os-release && printf '%s' "$ID")"
  os_version="$(. /etc/os-release && printf '%s' "$VERSION_ID")"
  printf '%s\n' 'Mission M0 (6 questions)'
  check_env_field M0-OBS-01 "$evidence" OS_ID "$os_id" 'OS_ID matches the live system'
  check_env_field M0-OBS-02 "$evidence" OS_VERSION_ID "$os_version" 'OS_VERSION_ID matches the live system'
  check_env_field M0-OBS-03 "$evidence" KERNEL_RELEASE "$(uname -r)" 'KERNEL_RELEASE matches the live system'
  check_env_field M0-OBS-04 "$evidence" PID1_COMM "$(cat /proc/1/comm)" 'PID1_COMM matches the live system'
  check_env_field M0-OBS-05 "$evidence" USER_NAME "$student_user" 'USER_NAME matches the live system'
  check_env_field M0-OBS-06 "$evidence" HOST_NAME "$(hostname)" 'HOST_NAME matches the live system'
}

check_m1() {
  local base="$student_home/jdu-lab/m1/case01" source=/opt/jdu-lab/fixtures/m1/source evidence
  [[ -d "$base/config" && -d "$base/logs" && -d "$base/notes" ]] && pass M1-FS-01 'Required directories exist' || not_ready M1-FS-01 'Build the required case01 tree'
  [[ -f "$base/config/app.conf" && -f "$base/logs/incident.log" ]] && pass M1-FS-02 'Required files are placed' || not_ready M1-FS-02 'Place the required files'
  if [[ -f "$base/config/app.conf" && -f "$base/logs/incident.log" ]]; then
    if cmp -s "$source/config/app.conf" "$base/config/app.conf" && cmp -s "$source/logs/incident.log" "$base/logs/incident.log"; then
      pass M1-FS-03 'Source content is preserved'
    else
      fail M1-FS-03 'A protected source copy was changed'
    fi
  else
    not_ready M1-FS-03 'Protected copies are not ready'
  fi
  if find "$base" -maxdepth 2 -type f -name '*.tmp' 2>/dev/null | grep -q .; then fail M1-FS-04 'Remove only the specified temporary files'; else pass M1-FS-04 'No unwanted temporary files remain'; fi
  if [[ -d "$base" ]] && find "$base" ! -user "$student_user" -print -quit | grep -q .; then fail M1-FS-05 'Student must own the case01 tree'; elif [[ -d "$base" ]]; then pass M1-FS-05 'Student owns the case01 tree'; else not_ready M1-FS-05 'case01 is not ready'; fi
  evidence="$base/notes/errors.txt"
  if [[ ! -f "$evidence" ]]; then
    not_ready M1-TXT-01 'Create notes/errors.txt with the complete ERROR lines'
  elif diff -u <(grep 'ERROR' "$source/logs/incident.log") "$evidence" >/dev/null 2>&1; then
    pass M1-TXT-01 'ERROR lines are correct'
  else
    fail M1-TXT-01 'errors.txt must contain only the complete ERROR lines without source line numbers'
  fi
  evidence="$base/notes/recent.txt"
  if [[ ! -f "$evidence" ]]; then
    not_ready M1-TXT-02 'Create notes/recent.txt with the latest five lines'
  elif diff -u <(tail -n 5 "$source/logs/incident.log") "$evidence" >/dev/null 2>&1; then
    pass M1-TXT-02 'The latest five lines are correct'
  else
    fail M1-TXT-02 'recent.txt does not match the latest five log lines'
  fi
}

check_m2() {
  local directory=/srv/jdu-share positive denied inherited positive_ok=false read_ok=false
  if getent group ops >/dev/null && getent passwd jduops >/dev/null && getent passwd jduviewer >/dev/null; then pass M2-ID-01 'Required users and group exist'; else error M2-ID-01 'Mission identities are missing'; return; fi
  if id -nG jduops | tr ' ' '\n' | grep -Fxq ops && ! id -nG jduviewer | tr ' ' '\n' | grep -Fxq ops; then pass M2-ID-02 'Only the authorized user is an ops member'; else not_ready M2-ID-02 'Complete the required group membership'; fi
  if [[ "$(stat -c '%U:%G' "$directory" 2>/dev/null || true)" == root:ops ]]; then pass M2-PERM-01 'Shared directory owner and group are correct'; else not_ready M2-PERM-01 'Set the required owner and group'; fi
  if [[ "$(stat -c '%a' "$directory" 2>/dev/null || true)" == 2775 ]]; then pass M2-PERM-02 'Shared directory mode is setgid and not world-writable'; else not_ready M2-PERM-02 'Set the required group collaboration mode'; fi
  positive="$directory/.jdu-check-ops-$$"
  if sudo -n -u jduops -- touch "$positive" 2>/dev/null; then positive_ok=true; pass M2-PERM-03 'Authorized user can create a file'; else not_ready M2-PERM-03 'Authorized write does not yet succeed'; fi
  if $positive_ok && [[ "$(stat -c '%G' "$positive" 2>/dev/null || true)" == ops ]]; then pass M2-PERM-06 'New file inherits the ops group'; elif $positive_ok; then fail M2-PERM-06 'New file did not inherit the ops group'; else not_ready M2-PERM-06 'Inheritance requires a successful authorized write'; fi
  sudo -n rm -f -- "$positive" >/dev/null 2>&1 || true
  if sudo -n -u jduviewer -- test -r "$directory/README.txt"; then read_ok=true; pass M2-PERM-05 'Viewer can read the shared sample'; else not_ready M2-PERM-05 'Viewer read access must remain available'; fi
  denied="$directory/.jdu-check-viewer-$$"
  if $positive_ok && $read_ok; then
    if ! sudo -n -u jduviewer -- touch "$denied" 2>/dev/null && [[ ! -e "$denied" ]]; then pass M2-PERM-04 'Viewer write is rejected without a side effect'; else fail M2-PERM-04 'Viewer can write or left an unexpected file'; fi
  else
    not_ready M2-PERM-04 'Denied-write check requires successful authorized write and viewer read'
  fi
  sudo -n rm -f -- "$denied" >/dev/null 2>&1 || true
}

check_m3() {
  local version process2_running=false
  if systemctl is-active --quiet jdu-m3-process2.service; then
    process2_running=true
  fi
  if $process2_running; then not_ready M3-PROC-01 'Stop process2'; else pass M3-PROC-01 'process2 is stopped'; fi
  if systemctl is-active --quiet jdu-m3-process1.service; then pass M3-PROC-02 'process1 remains active'; else fail M3-PROC-02 'process1 must remain active'; fi
  if systemctl is-active --quiet jdu-m3-process3.service; then pass M3-PROC-03 'process3 remains active'; else fail M3-PROC-03 'process3 must remain active'; fi
  version="$(dpkg-query -W -f='${Status}:${Version}' cmatrix 2>/dev/null || true)"
  if [[ "$version" == 'install ok installed:'* ]]; then pass M3-APT-01 'Required package cmatrix is installed'; else not_ready M3-APT-01 'Install cmatrix after inspecting its package information'; fi
  if [[ "$version" == 'install ok installed:'* && -n "${version#*:}" ]]; then pass M3-APT-02 'Installed package has a version'; else not_ready M3-APT-02 'Installed version is not available'; fi
  if [[ -x /usr/bin/cmatrix && "$(dpkg-query -S /usr/bin/cmatrix 2>/dev/null | cut -d: -f1)" == cmatrix ]]; then pass M3-APT-03 'cmatrix provides the installed command'; else not_ready M3-APT-03 'Verify the cmatrix command and its package'; fi
}

check_m4() {
  local pid active enabled user base_hash actual_hash properties command_line working_directory
  systemctl cat jdu-status.service >/dev/null 2>&1 && pass M4-UNIT-01 'jdu-status.service is loaded' || error M4-UNIT-01 'Base unit is missing'
  base_hash="$(cat /opt/jdu-lab/fixtures/m4/jdu-status.service.sha256 2>/dev/null || true)"; actual_hash="$(sha256sum /etc/systemd/system/jdu-status.service 2>/dev/null | awk '{print $1}')"
  [[ -n "$base_hash" && "$actual_hash" == "$base_hash" ]] && pass M4-UNIT-02 'Teacher-provided base unit is unchanged' || fail M4-UNIT-02 'Base unit checksum changed'
  properties="$(systemctl show jdu-status.service -p User -p ExecStart -p WorkingDirectory 2>/dev/null || true)"
  if grep -Fxq 'User=jduapp' <<<"$properties" && grep -Fxq 'WorkingDirectory=/srv/jdu-status' <<<"$properties" && grep -q '/opt/jdu-lab/bin/jdu-http-service' <<<"$properties"; then pass M4-UNIT-03 'Effective service properties match the requirements'; else fail M4-UNIT-03 'Compare User, ExecStart, and WorkingDirectory'; fi
  active="$(systemctl is-active jdu-status.service 2>/dev/null || true)"; enabled="$(systemctl is-enabled jdu-status.service 2>/dev/null || true)"; pid="$(service_pid jdu-status.service)"; user="$(service_user "$pid" 2>/dev/null || true)"
  [[ "$active" == active ]] && pass M4-SVC-01 'Service is active' || not_ready M4-SVC-01 'Start the course service'
  [[ "$enabled" == enabled ]] && pass M4-SVC-02 'Service is enabled for boot' || not_ready M4-SVC-02 'Set the required boot state'
  if [[ "$pid" =~ ^[1-9][0-9]*$ ]] && sudo -n test -d "/proc/$pid" 2>/dev/null; then pass M4-SVC-03 'MainPID identifies a live process'; else not_ready M4-SVC-03 'Start the service and inspect its MainPID'; fi
  [[ "$pid" =~ ^[1-9][0-9]*$ && "$user" == jduapp ]] && pass M4-SVC-04 'The live process runs as jduapp' || not_ready M4-SVC-04 'Relate MainPID to the configured service user'
  command_line=''; working_directory=''
  if [[ "$pid" =~ ^[1-9][0-9]*$ ]]; then
    command_line="$(sudo -n cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' || true)"
    working_directory="$(sudo -n readlink -f "/proc/$pid/cwd" 2>/dev/null || true)"
  fi
  if [[ "$command_line" == *'/opt/jdu-lab/bin/jdu-http-service'* && "$working_directory" == /srv/jdu-status ]]; then pass M4-SVC-05 'The live process uses the required command and working directory'; else not_ready M4-SVC-05 'Inspect the live process command and working directory'; fi
}

check_m5() {
  local pid socket_line socket_pid marker body status invocation_id journal closed_exit
  pid="$(service_pid jdu-status.service)"; marker="$(cat /etc/jdu-lab/status-marker 2>/dev/null || true)"
  socket_line="$(sudo -n ss -H -lntp 2>/dev/null | awk '$4 ~ /127[.]0[.]0[.]1:8080$/ {print; exit}')"
  if [[ -n "$socket_line" ]]; then pass M5-SOCK-01 'TCP 8080 listens on 127.0.0.1'; else not_ready M5-SOCK-01 'Find the expected loopback listener'; fi
  if sudo -n ss -H -lnt 2>/dev/null | awk '{print $4}' | grep -Eq '(^0[.]0[.]0[.]0|^\[::\]|^\*):8080$'; then fail M5-SOCK-02 'Service listens on a broad address'; else pass M5-SOCK-02 'No broad TCP 8080 listener exists'; fi
  socket_pid="$(sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' <<<"$socket_line")"
  [[ -n "$pid" && "$socket_pid" == "$pid" ]] && pass M5-SOCK-03 'Listener belongs to the service MainPID' || not_ready M5-SOCK-03 'Relate the listener process to MainPID'
  body="$(mktemp)"
  status="$(curl -sS --max-time 3 -o "$body" -w '%{http_code}' http://127.0.0.1:8080/ 2>/dev/null || true)"
  if [[ "$status" == 200 ]] && grep -Fqx "$marker" "$body"; then pass M5-HTTP-01 'Local HTTP request returns 200 and the expected marker'; else not_ready M5-HTTP-01 'Verify the local response status and marker'; fi
  invocation_id="$(systemctl show jdu-status.service -p InvocationID --value 2>/dev/null || true)"
  journal=''
  if [[ -n "$invocation_id" ]]; then
    journal="$(sudo -n journalctl -u jdu-status.service "_SYSTEMD_INVOCATION_ID=$invocation_id" --no-pager -o cat 2>/dev/null | grep -Fx 'REQUEST path=/m5-check' | tail -n 1)"
  fi
  [[ -n "$journal" ]] && pass M5-LOG-01 'The current service invocation logged the student request to /m5-check' || not_ready M5-LOG-01 'Request /m5-check and find its journal entry'
  if sudo -n -u jduapp -- test -r /srv/jdu-status/index.txt; then pass M5-FILE-01 'Service user can read its content'; else fail M5-FILE-01 'Service user cannot read its content'; fi
  closed_exit=0
  curl -fsS --max-time 2 http://127.0.0.1:18080/ >/dev/null 2>&1 || closed_exit=$?
  if ((closed_exit != 0)) && ! sudo -n ss -H -lnt 2>/dev/null | awk '{print $4}' | grep -Eq '(^|:)18080$'; then pass M5-NEG-01 'Unused port rejects the request and has no listener'; else fail M5-NEG-01 'Unused-port negative condition is not satisfied'; fi
  rm -f -- "$body"
}

check_m6() {
  local ssh_directory="$student_home/.ssh" authorized="$student_home/.ssh/authorized_keys" upload="$student_home/jdu-lab/m6/upload.txt" result="$student_home/jdu-lab/m6/remote-result.txt" expected_result
  systemctl is-active --quiet ssh.service && pass M6-SSH-01 'SSH service is active' || error M6-SSH-01 'SSH service is not active'
  if sudo -n ss -H -lnt 2>/dev/null | awk '{print $4}' | grep -Eq '(^|:)22$'; then pass M6-SSH-02 'TCP 22 listens inside the instance'; else error M6-SSH-02 'SSH listener is missing'; fi
  if [[ "$(stat -c '%U:%a' "$ssh_directory" 2>/dev/null || true)" == "$student_user:700" && "$(stat -c '%U:%a' "$authorized" 2>/dev/null || true)" == "$student_user:600" ]]; then pass M6-SSH-03 'SSH directory and authorized_keys have safe ownership and modes'; else fail M6-SSH-03 'Inspect SSH file ownership and modes'; fi
  if [[ -s /etc/jdu-lab/student-ssh-key.pub ]] && grep -Fqx -f /etc/jdu-lab/student-ssh-key.pub "$authorized" 2>/dev/null; then pass M6-SSH-04 'CloudShell public key is registered'; else fail M6-SSH-04 'Registered public key does not match the lab key'; fi
  sudo -n sshd -t >/dev/null 2>&1 && pass M6-SSH-05 'sshd configuration syntax is valid' || fail M6-SSH-05 'sshd configuration validation failed'
  if [[ -f "$upload" ]] && grep -Fqx 'JDU SSH transfer test' "$upload" && [[ "$(wc -l < "$upload")" -eq 1 ]]; then pass M6-XFER-01 'The transferred file has the required content'; else not_ready M6-XFER-01 'Transfer local-source.txt to upload.txt with scp'; fi
  if [[ -f "$upload" && "$(stat -c '%U:%a' "$upload" 2>/dev/null || true)" == "$student_user:644" ]]; then pass M6-XFER-02 'The transferred file has safe ownership and mode 644'; else not_ready M6-XFER-02 'Inspect the transferred file ownership and mode'; fi
  expected_result="$(printf 'REMOTE_USER=%s\nREMOTE_HOST=%s\nREMOTE_PATH=%s\n' "$student_user" "$(hostname)" "$student_home")"
  if [[ -f "$result" && "$(cat "$result" 2>/dev/null || true)" == "$expected_result" ]]; then pass M6-REMOTE-01 'The SSH remote command recorded the live remote identity'; else not_ready M6-REMOTE-01 'Create remote-result.txt with an SSH remote command'; fi
}

check_m7() {
  local evidence="$student_home/jdu-lab/m7/evidence.env" pid active enabled user socket_line socket_pid marker body status journal requested epoch now positive denied viewer_exit base_hash current_hash
  systemctl cat jdu-final.service >/dev/null 2>&1 && pass M7-UNIT-01 'Final service unit is loaded' || not_ready M7-UNIT-01 'Create the final unit from the read-only template'
  active="$(systemctl is-active jdu-final.service 2>/dev/null || true)"; enabled="$(systemctl is-enabled jdu-final.service 2>/dev/null || true)"; pid="$(service_pid jdu-final.service)"; user="$(service_user "$pid" 2>/dev/null || true)"
  [[ "$active" == active && "$enabled" == enabled ]] && pass M7-SVC-01 'Final service is active and enabled' || not_ready M7-SVC-01 'Complete current and boot service states'
  [[ "$pid" =~ ^[1-9][0-9]*$ && "$user" == jdufinal ]] && pass M7-SVC-02 'Final MainPID runs as jdufinal' || not_ready M7-SVC-02 'Relate MainPID to the required service user'
  socket_line="$(sudo -n ss -H -lntp 2>/dev/null | awk '$4 ~ /127[.]0[.]0[.]1:8090$/ {print; exit}')"; socket_pid="$(sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' <<<"$socket_line")"
  if [[ -n "$socket_line" && "$socket_pid" == "$pid" ]] && ! sudo -n ss -H -lnt 2>/dev/null | awk '{print $4}' | grep -Eq '(^0[.]0[.]0[.]0|^\[::\]|^\*):8090$'; then pass M7-SOCK-01 'Final service alone listens on loopback TCP 8090'; else not_ready M7-SOCK-01 'Check protocol, address, port, and owning process'; fi
  marker="$(cat /etc/jdu-lab/final-marker 2>/dev/null || true)"; body="$(mktemp)"
  status="$(curl -sS --max-time 3 -o "$body" -w '%{http_code}' http://127.0.0.1:8090/ 2>/dev/null || true)"
  [[ "$status" == 200 ]] && grep -Fqx "$marker" "$body" && pass M7-HTTP-01 'Final HTTP response returns 200 and the assigned marker' || not_ready M7-HTTP-01 'Verify the final local response'
  journal="$(journalctl -u jdu-final.service -n 30 --no-pager -o cat 2>/dev/null | grep 'REQUEST path=' | tail -n 1)"
  [[ -n "$journal" ]] && pass M7-LOG-01 'Final request is present in the journal' || not_ready M7-LOG-01 'Find the request event in the final journal'
  if [[ "$(stat -c '%U:%G:%a' /srv/jdu-final/index.txt 2>/dev/null || true)" == root:finalops:664 && "$(stat -c '%U:%G:%a' /srv/jdu-final 2>/dev/null || true)" == root:finalops:2775 ]]; then pass M7-PERM-01 'Final content and directory have the required ownership and modes'; else not_ready M7-PERM-01 'Complete content ownership, group, and permissions'; fi
  positive=/srv/jdu-final/.jdu-writer-check-$$; denied=/srv/jdu-final/.jdu-viewer-check-$$
  if sudo -n -u jduwriter -- touch "$positive" 2>/dev/null; then pass M7-PERM-02 'Authorized group user can update the content directory'; else not_ready M7-PERM-02 'Authorized group update must succeed first'; fi
  sudo -n -u jduviewer -- touch "$denied" 2>/dev/null; viewer_exit=$?
  if [[ -e "$positive" ]] && ((viewer_exit != 0)) && [[ ! -e "$denied" ]]; then pass M7-PERM-03 'Viewer update is rejected without a side effect'; else not_ready M7-PERM-03 'Negative permission check requires a working authorized path'; fi
  sudo -n rm -f -- "$positive" "$denied" >/dev/null 2>&1 || true
  requested="$(read_env_value "$evidence" REQUESTED_AT_UTC 2>/dev/null || true)"; epoch="$(date -d "$requested" +%s 2>/dev/null || true)"; now="$(date +%s)"
  if [[ -z "$epoch" ]] || ((now - epoch < 0 || now - epoch > 1800)); then
    not_ready M7-EVID-01 'Create evidence.env with a valid recent UTC request time'
  else
    check_env_result M7-EVID-01 "$evidence" 'Final evidence matches the live integrated state' \
      "ACTIVE_STATE:$active" "UNIT_FILE_STATE:$enabled" "MAIN_PID:$pid" "SERVICE_USER:$user" \
      'PROTOCOL:tcp' 'LOCAL_ADDRESS:127.0.0.1' 'SERVICE_PORT:8090' 'HTTP_STATUS:200' "HTTP_MARKER:$marker" \
      "REQUESTED_AT_UTC:$requested" 'CONTENT_OWNER:root' 'CONTENT_GROUP:finalops' 'CONTENT_MODE:664' "VIEWER_EXIT_CODE:$viewer_exit"
  fi
  base_hash="$(cat /opt/jdu-lab/fixtures/m7/jdu-final.service.template.sha256 2>/dev/null || true)"; current_hash="$(sha256sum /opt/jdu-lab/fixtures/m7/jdu-final.service.template 2>/dev/null | awk '{print $1}')"
  [[ -n "$base_hash" && "$current_hash" == "$base_hash" ]] && pass M7-INT-01 'Final template is unchanged' || error M7-INT-01 'Final template integrity failed'
  if sha256sum --check --status /etc/jdu-lab/ssh-baseline.sha256 2>/dev/null; then pass M7-INT-02 'SSH server configuration is unchanged'; else fail M7-INT-02 'SSH server configuration changed during the final Mission'; fi
  if sha256sum --check --status /etc/jdu-lab/checker-baseline.sha256 2>/dev/null; then pass M7-INT-03 'LabCheck program is unchanged'; else error M7-INT-03 'LabCheck integrity failed'; fi
  rm -f -- "$body"
}

if [[ "${1:-}" == list ]]; then
  printf '%s\n' 'M0 Environment and OS' 'M1 Shell, path, file, and text' 'M2 User, group, permission, and sudo' 'M3 Process and package' 'M4 systemd service' 'M5 Port, socket, and log' 'M6 SSH and remote operation' 'M7 Integrated Ubuntu check'
  exit 0
fi

if [[ "${1:-}" == final ]]; then
  mission=M7
elif [[ "${1:-}" == mission ]]; then
  mission="${2:-}"
else
  mission="${1:-}"
fi
mission="${mission^^}"
case "$mission" in
  M0) check_m0 ;;
  M1) check_m1 ;;
  M2) check_m2 ;;
  M3) check_m3 ;;
  M4) check_m4 ;;
  M5) check_m5 ;;
  M6) check_m6 ;;
  M7) check_m7 ;;
  *) printf '%s\n' 'Usage: jdu-labcheck list | mission M0|M1|M2|M3|M4|M5|M6|M7 | final' >&2; exit 2 ;;
esac
finish
