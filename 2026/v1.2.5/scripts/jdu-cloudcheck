#!/usr/bin/env bash
set -u

key_path="${JDU_SSH_KEY_PATH:-$HOME/.ssh/jdu-intro-cybersecurity-2026}"
alias_name="${JDU_SSH_ALIAS:-jdu-ubuntu}"
pass_count=0
not_ready_count=0
fail_count=0

pass() { pass_count=$((pass_count + 1)); printf 'PASS      %-12s %s\n' "$1" "$2"; }
not_ready() { not_ready_count=$((not_ready_count + 1)); printf 'NOT_READY %-12s %s\n' "$1" "$2"; }
fail() { fail_count=$((fail_count + 1)); printf 'FAIL      %-12s %s\n' "$1" "$2"; }

mission="${2:-${1:-}}"
mission="${mission^^}"
if [[ "$mission" != M6 ]]; then
  printf '%s\n' 'Usage: jdu-cloudcheck mission M6' >&2
  exit 2
fi

if [[ ! -f "$key_path" ]]; then
  not_ready M6-LOCAL-01 'CloudShell private key is missing'
else
  key_mode="$(stat -c '%a' "$key_path" 2>/dev/null || true)"
  [[ "$key_mode" == 600 ]] && pass M6-LOCAL-01 'Private key mode is 600' || fail M6-LOCAL-01 'Private key must not be accessible to group or other users'
fi

if [[ -f "$key_path.pub" ]]; then
  pass M6-LOCAL-02 'Public key exists'
else
  not_ready M6-LOCAL-02 'Matching public key is missing'
fi

if remote_identity="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias_name" 'printf "%s:%s" "$(id -un)" "$(hostname)"' 2>/dev/null)" && [[ "$remote_identity" == ssm-user:* ]]; then
  pass M6-LOCAL-03 'Registered key authenticates to the Ubuntu instance'
else
  fail M6-LOCAL-03 'SSH connection with the registered key failed'
fi

if ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias_name" 'test -s ~/jdu-lab/m6/remote-success.env' 2>/dev/null; then
  pass M6-LOCAL-04 'Remote evidence exists'
else
  not_ready M6-LOCAL-04 'Create remote-success.env through a new SSH command'
fi

printf 'Summary: %d PASS, %d NOT_READY, %d FAIL\n' "$pass_count" "$not_ready_count" "$fail_count"
((not_ready_count == 0 && fail_count == 0))
