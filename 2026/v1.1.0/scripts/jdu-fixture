#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  printf '%s\n' 'Usage: jdu-fixture reset M0|M1|all'
}

if [[ "${1:-}" != "reset" || -z "${2:-}" ]]; then
  usage >&2
  exit 2
fi

mission="${2^^}"
workspace="${HOME}/jdu-lab"

reset_m0() {
  install -d -m 0755 "$workspace/m0"
  rm -f -- "$workspace/m0/observation.env"
  printf '%s\n' 'M0 reset complete. observation.env is intentionally absent.'
}

reset_m1() {
  local target="$workspace/m1"
  case "$target" in
    "$HOME"/jdu-lab/m1) ;;
    *) printf '%s\n' 'ERROR Unsafe reset target' >&2; exit 2 ;;
  esac
  rm -rf -- "$target"
  install -d -m 0755 "$target/inbox"
  cp -a /opt/jdu-lab/fixtures/m1/source/. "$target/inbox/"
  chmod -R u+rwX "$target/inbox"
  printf '%s\n' 'M1 reset complete. case01 is intentionally absent.'
}

case "$mission" in
  M0) reset_m0 ;;
  M1) reset_m1 ;;
  ALL) reset_m0; reset_m1 ;;
  *) printf 'ERROR Mission is not implemented in %s: %s\n' "$(cat /etc/jdu-lab/version 2>/dev/null || printf unknown)" "$mission" >&2; exit 2 ;;
esac
