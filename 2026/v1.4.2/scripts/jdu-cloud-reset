#!/usr/bin/env bash
set -Eeuo pipefail

mission="${1:-}"
mission="${mission^^}"
if [[ "$mission" != M6 ]]; then
  printf '%s\n' 'Usage: jdu-reset M6' >&2
  exit 2
fi

workspace="${JDU_M6_WORKSPACE:-$HOME/jdu-lab/m6}"
case "$workspace" in
  "$HOME"/jdu-lab/m6) ;;
  *) printf 'ERROR Unsafe Mission 6 workspace: %s\n' "$workspace" >&2; exit 2 ;;
esac

install -d -m 0700 "$workspace"
rm -f -- "$workspace/local-source.txt" "$workspace/downloaded-result.txt"
printf '%s\n' 'M6 CloudShell reset complete. Student transfer files are intentionally absent.'
