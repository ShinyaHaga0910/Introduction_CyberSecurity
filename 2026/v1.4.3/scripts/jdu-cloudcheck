#!/usr/bin/env bash
set -u
export LC_ALL=C

alias_name="${JDU_SSH_ALIAS:-jdu-ubuntu}"
workspace="${JDU_M6_WORKSPACE:-$HOME/jdu-lab/m6}"
progress_config="${JDU_CLOUD_PROGRESS_CONFIG:-$HOME/.jdu-student/progress.env}"
submit_progress=true
pass_count=0
fail_count=0

pass() { pass_count=$((pass_count + 1)); printf 'PASS      %-14s %s\n' "$1" "$2"; }
fail() { fail_count=$((fail_count + 1)); printf 'FAIL      %-14s %s\n' "$1" "$2"; }
finish() {
  local total=$((pass_count + fail_count)) result_status=0 endpoint server_id server_token body
  printf '\nRESULT    %d / %d checks cleared\n' "$pass_count" "$total"
  printf 'PASS      %d\n' "$pass_count"
  printf 'FAIL      %d\n' "$fail_count"
  ((fail_count == 0)) || result_status=1
  if $submit_progress && [[ -r "$progress_config" ]]; then
    endpoint="$(sed -n 's/^JDU_PROGRESS_ENDPOINT=//p' "$progress_config" | tail -n 1)"
    server_id="$(sed -n 's/^JDU_PROGRESS_SERVER_ID=//p' "$progress_config" | tail -n 1)"
    server_token="$(sed -n 's/^JDU_PROGRESS_SERVER_TOKEN=//p' "$progress_config" | tail -n 1)"
    if [[ "$endpoint" =~ ^https://[^[:space:]]+$ && "$server_id" =~ ^[A-Za-z0-9_-]{8,64}$ && ${#server_token} -ge 32 ]]; then
      body="$(printf '{\"server_id\":\"%s\",\"mission\":\"M6C\",\"passed\":%d,\"total\":%d}' "$server_id" "$pass_count" "$total")"
      if curl -fsS --retry 2 --max-time 15 -X POST -H "Authorization: Bearer $server_token" -H 'Content-Type: application/json' --data-binary "$body" "${endpoint%/}/submit" >/dev/null; then
        printf 'REPORT    PASS (server %s, M6-CloudShell)\n' "$server_id"
      else
        printf '%s\n' 'REPORT    FAIL (the CloudShell check result was not changed)' >&2
      fi
    fi
  fi
  return "$result_status"
}

mission=''
while (($#)); do
  case "$1" in
    mission) shift; mission="${1:-}" ;;
    M6|m6) mission=M6 ;;
    --submit) submit_progress=true ;;
    --no-submit) submit_progress=false ;;
    *) printf 'ERROR Unknown option: %s\n' "$1" >&2; printf '%s\n' 'Usage: jdu-check M6 [--no-submit]' >&2; exit 2 ;;
  esac
  shift
done
mission="${mission^^}"
if [[ "$mission" != M6 ]]; then
  printf '%s\n' 'Usage: jdu-check M6 [--no-submit]' >&2
  exit 2
fi

printf '%s\n' 'Mission M6 CloudShell side (4 tasks)'

local_source="$workspace/local-source.txt"
local_hash=''
if [[ -f "$local_source" ]] && grep -Fqx 'JDU SSH transfer test' "$local_source" && [[ "$(wc -l < "$local_source")" -eq 1 ]]; then
  local_hash="$(sha256sum "$local_source" | awk '{print $1}')"
  pass M6-LOCAL-01 'CloudShell source has the required one-line content'
else
  fail M6-LOCAL-01 'Create local-source.txt with the required one-line content'
fi

remote_upload_output="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias_name" 'sha256sum ~/jdu-lab/m6/upload.txt' 2>/dev/null || true)"
remote_upload_hash="$(awk '{print $1}' <<<"$remote_upload_output")"
if [[ -n "$local_hash" && "$remote_upload_hash" == "$local_hash" ]]; then
  pass M6-XFER-01 'Ubuntu upload.txt matches the CloudShell source'
else
  fail M6-XFER-01 'Transfer local-source.txt to Ubuntu as upload.txt'
fi

remote_expected="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias_name" 'printf "REMOTE_USER=%s\nREMOTE_HOST=%s\nREMOTE_PATH=%s\n" "$(id -un)" "$(hostname)" "$HOME"' 2>/dev/null || true)"
remote_actual="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias_name" 'cat ~/jdu-lab/m6/remote-result.txt' 2>/dev/null || true)"
if [[ -n "$remote_expected" && "$remote_actual" == "$remote_expected" ]]; then
  pass M6-REMOTE-01 'Ubuntu remote-result.txt records the live remote identity'
else
  fail M6-REMOTE-01 'Create remote-result.txt by running a command through SSH'
fi

downloaded_result="$workspace/downloaded-result.txt"
downloaded_hash=''
if [[ -f "$downloaded_result" ]]; then
  downloaded_hash="$(sha256sum "$downloaded_result" | awk '{print $1}')"
fi
remote_result_output="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias_name" 'sha256sum ~/jdu-lab/m6/remote-result.txt' 2>/dev/null || true)"
remote_result_hash="$(awk '{print $1}' <<<"$remote_result_output")"
if [[ -n "$downloaded_hash" && "$remote_result_hash" == "$downloaded_hash" ]]; then
  pass M6-XFER-02 'CloudShell download matches the Ubuntu result'
else
  fail M6-XFER-02 'Download remote-result.txt to downloaded-result.txt'
fi

finish
