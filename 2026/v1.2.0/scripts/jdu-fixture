#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  printf '%s\n' 'Usage: jdu-fixture reset M0|M1|M2|M3|M4|M5|M6|M7|all'
}

if [[ "${1:-}" != "reset" || -z "${2:-}" ]]; then
  usage >&2
  exit 2
fi

if ((EUID != 0)); then
  exec sudo -n -- "$0" "$@"
fi

mission="${2^^}"
student_user="${JDU_STUDENT_USER:-${SUDO_USER:-ssm-user}}"
if [[ "$student_user" == root ]] || ! getent passwd "$student_user" >/dev/null; then
  student_user=ssm-user
fi
student_home="$(getent passwd "$student_user" | awk -F: '{print $6}')"
student_group="$(id -gn "$student_user")"
workspace="$student_home/jdu-lab"

case "$workspace" in
  /home/*/jdu-lab) ;;
  *) printf 'ERROR Unsafe student workspace: %s\n' "$workspace" >&2; exit 2 ;;
esac

prepare_home_directory() {
  local mission_id="$1" directory="$workspace/${mission_id,,}"
  install -d -o "$student_user" -g "$student_group" -m 0750 "$directory"
  find "$directory" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
}

ensure_account() {
  local user_name="$1" shell_name="${2:-/usr/sbin/nologin}"
  if ! getent passwd "$user_name" >/dev/null; then
    useradd --create-home --shell "$shell_name" "$user_name"
  fi
}

reset_m0() {
  prepare_home_directory M0
  printf '%s\n' 'M0 reset complete. observation.env is intentionally absent.'
}

reset_m1() {
  prepare_home_directory M1
  install -d -o "$student_user" -g "$student_group" -m 0750 "$workspace/m1/inbox"
  cp -a /opt/jdu-lab/fixtures/m1/source/. "$workspace/m1/inbox/"
  chown -R "$student_user:$student_group" "$workspace/m1"
  chmod -R u+rwX,go-rwx "$workspace/m1"
  printf '%s\n' 'M1 reset complete. case01 is intentionally absent.'
}

reset_m2() {
  prepare_home_directory M2
  getent group ops >/dev/null || groupadd ops
  ensure_account jduops /bin/bash
  ensure_account jduviewer /bin/bash
  gpasswd -d jduops ops >/dev/null 2>&1 || true
  gpasswd -d jduviewer ops >/dev/null 2>&1 || true
  install -d -o root -g root -m 0755 /srv/jdu-share
  find /srv/jdu-share -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
  printf '%s\n' 'This file must remain readable to the viewer.' > /srv/jdu-share/README.txt
  chown root:root /srv/jdu-share/README.txt
  chmod 0644 /srv/jdu-share/README.txt
  printf '%s\n' 'M2 reset complete. Users exist; membership and shared-directory permissions are intentionally unfinished.'
}

stop_m3_workers() {
  local unit
  for unit in jdu-m3-target.service jdu-m3-decoy-a.service jdu-m3-decoy-b.service; do
    systemctl stop "$unit" >/dev/null 2>&1 || true
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
  done
}

start_m3_worker() {
  local unit_name="$1" user_name="$2" token="$3"
  systemd-run --quiet --unit "$unit_name" --property "User=$user_name" \
    /opt/jdu-lab/bin/jdu-worker "$token"
}

reset_m3() {
  prepare_home_directory M3
  ensure_account jdutarget
  ensure_account jdudecoy
  if dpkg-query -W -f='${Status}' tree 2>/dev/null | grep -Fxq 'install ok installed'; then
    DEBIAN_FRONTEND=noninteractive apt-get remove -y -qq tree >/dev/null
  fi
  stop_m3_workers
  install -d -m 0755 /run/jdu-lab/m3
  start_m3_worker jdu-m3-target jdutarget blue-otter
  start_m3_worker jdu-m3-decoy-a jdudecoy amber-fox
  start_m3_worker jdu-m3-decoy-b jdudecoy green-owl
  sleep 1
  printf '%s\n' \
    'TARGET_USER=jdutarget' \
    'TARGET_TOKEN=blue-otter' \
    "TARGET_PID=$(systemctl show -p MainPID --value jdu-m3-target.service)" \
    'DECOY_A_TOKEN=amber-fox' \
    'DECOY_B_TOKEN=green-owl' > /run/jdu-lab/m3/metadata.env
  chmod 0644 /run/jdu-lab/m3/metadata.env
  printf '%s\n' 'M3 reset complete. Three workers are running; the target and package evidence are intentionally unfinished.'
}

restore_status_unit() {
  install -o root -g root -m 0644 /opt/jdu-lab/fixtures/m4/jdu-status.service /etc/systemd/system/jdu-status.service
  rm -rf -- /etc/systemd/system/jdu-status.service.d
  systemctl daemon-reload
}

reset_m4() {
  prepare_home_directory M4
  systemctl disable --now jdu-status.service >/dev/null 2>&1 || true
  restore_status_unit
  printf '%s\n' 'M4 reset complete. jdu-status.service is loaded, inactive, and disabled.'
}

reset_m5() {
  prepare_home_directory M5
  restore_status_unit
  systemctl enable --now jdu-status.service >/dev/null
  printf '%s\n' 'M5 reset complete. The service is healthy; observation and closed-port probe records are intentionally absent.'
}

reset_m6() {
  prepare_home_directory M6
  rm -f -- "$workspace/m6/remote-success.env" "$workspace/m6/unexpected-success"
  systemctl enable --now ssh.service >/dev/null
  printf '%s\n' 'M6 reset complete. SSH remains available; remote evidence is intentionally absent.'
}

reset_m7() {
  prepare_home_directory M7
  getent group finalops >/dev/null || groupadd finalops
  ensure_account jdufinal
  ensure_account jduwriter /bin/bash
  ensure_account jduviewer /bin/bash
  usermod -aG finalops jdufinal
  gpasswd -d jduwriter finalops >/dev/null 2>&1 || true
  gpasswd -d jduviewer finalops >/dev/null 2>&1 || true
  systemctl disable --now jdu-final.service >/dev/null 2>&1 || true
  rm -f -- /etc/systemd/system/jdu-final.service
  rm -rf -- /etc/systemd/system/jdu-final.service.d /srv/jdu-final
  systemctl daemon-reload
  printf '%s\n' 'M7 reset complete. Template remains read-only; the final service, content, membership, and evidence are intentionally unfinished.'
}

case "$mission" in
  M0) reset_m0 ;;
  M1) reset_m1 ;;
  M2) reset_m2 ;;
  M3) reset_m3 ;;
  M4) reset_m4 ;;
  M5) reset_m5 ;;
  M6) reset_m6 ;;
  M7) reset_m7 ;;
  ALL) reset_m0; reset_m1; reset_m2; reset_m3; reset_m4; reset_m5; reset_m6; reset_m7 ;;
  *) printf 'ERROR Unknown Mission: %s\n' "$mission" >&2; usage >&2; exit 2 ;;
esac
