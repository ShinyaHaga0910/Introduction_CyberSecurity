#!/usr/bin/env bash
set -u

student_user="$(id -un)"
student_home="$HOME"
checked_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

usage() {
  printf '%s\n' 'Usage: jdu-probe list | jdu-probe run M2-WRITE-DENY|M5-CLOSED-PORT|M6-UNREGISTERED-KEY'
}

record_probe() {
  local mission="$1" probe_id="$2" exit_code="$3" matched="$4" output_file
  output_file="$student_home/jdu-lab/${mission,,}/probes.env"
  install -d -m 0750 "$(dirname "$output_file")"
  {
    printf 'PROBE_ID=%s\n' "$probe_id"
    printf 'EXIT_CODE=%s\n' "$exit_code"
    printf 'EXPECTED_MATCH=%s\n' "$matched"
    printf 'CHECKED_AT_UTC=%s\n' "$checked_at"
  } > "$output_file"
  chmod 0600 "$output_file"
}

probe_m2() {
  local positive_path="/srv/jdu-share/.jdu-ops-probe-$$" denied_path="/srv/jdu-share/.jdu-viewer-probe-$$" viewer_exit
  if ! sudo -n -u jduops -- touch "$positive_path" 2>/dev/null; then
    printf '%s\n' 'NOT_READY Authorized write must succeed before the denied write is evaluated.'
    record_probe M2 M2-WRITE-DENY 125 false
    return 1
  fi
  sudo -n rm -f -- "$positive_path"
  if ! sudo -n -u jduviewer -- test -r /srv/jdu-share/README.txt; then
    printf '%s\n' 'NOT_READY Viewer read access must succeed before the denied write is evaluated.'
    record_probe M2 M2-WRITE-DENY 125 false
    return 1
  fi
  sudo -n -u jduviewer -- touch "$denied_path" 2>/dev/null
  viewer_exit=$?
  if ((viewer_exit != 0)) && [[ ! -e "$denied_path" ]]; then
    record_probe M2 M2-WRITE-DENY "$viewer_exit" true
    printf '%s\n' 'PASS M2-WRITE-DENY: viewer write was rejected and no file was created.'
    return 0
  fi
  sudo -n rm -f -- "$denied_path"
  record_probe M2 M2-WRITE-DENY "$viewer_exit" false
  printf '%s\n' 'FAIL M2-WRITE-DENY: inspect identity and directory permissions.'
  return 1
}

probe_m5() {
  local closed_exit
  if ! curl -fsS --max-time 3 http://127.0.0.1:8080/ >/dev/null; then
    printf '%s\n' 'NOT_READY The healthy HTTP request must succeed first.'
    record_probe M5 M5-CLOSED-PORT 125 false
    return 1
  fi
  curl -fsS --max-time 2 http://127.0.0.1:18080/ >/dev/null 2>&1
  closed_exit=$?
  if ((closed_exit != 0)) && ! sudo -n ss -H -lnt | awk '{print $4}' | grep -Eq '(^|:)18080$'; then
    record_probe M5 M5-CLOSED-PORT "$closed_exit" true
    printf '%s\n' 'PASS M5-CLOSED-PORT: the unused port rejected the request and has no listener.'
    return 0
  fi
  record_probe M5 M5-CLOSED-PORT "$closed_exit" false
  printf '%s\n' 'FAIL M5-CLOSED-PORT: compare the healthy listener with port 18080.'
  return 1
}

probe_m6() {
  local temporary_directory private_key marker="$student_home/jdu-lab/m6/unexpected-success" ssh_exit
  if ! systemctl is-active --quiet ssh.service || [[ ! -s "$student_home/.ssh/authorized_keys" ]]; then
    printf '%s\n' 'NOT_READY SSH service and the registered public key must be ready first.'
    record_probe M6 M6-UNREGISTERED-KEY 125 false
    return 1
  fi
  temporary_directory="$(mktemp -d)"
  private_key="$temporary_directory/unregistered"
  ssh-keygen -q -t ed25519 -N '' -f "$private_key"
  rm -f -- "$marker"
  ssh -i "$private_key" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=5 \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    "$student_user@127.0.0.1" "touch '$marker'" >/dev/null 2>&1
  ssh_exit=$?
  if ((ssh_exit == 255)) && [[ ! -e "$marker" ]]; then
    record_probe M6 M6-UNREGISTERED-KEY "$ssh_exit" true
    rm -rf -- "$temporary_directory"
    printf '%s\n' 'PASS M6-UNREGISTERED-KEY: authentication was rejected and the remote command did not run.'
    return 0
  fi
  rm -f -- "$marker"
  rm -rf -- "$temporary_directory"
  record_probe M6 M6-UNREGISTERED-KEY "$ssh_exit" false
  printf '%s\n' 'FAIL M6-UNREGISTERED-KEY: inspect key registration and authentication behavior.'
  return 1
}

case "${1:-}" in
  list)
    printf '%s\n' M2-WRITE-DENY M5-CLOSED-PORT M6-UNREGISTERED-KEY
    ;;
  run)
    case "${2:-}" in
      M2-WRITE-DENY) probe_m2 ;;
      M5-CLOSED-PORT) probe_m5 ;;
      M6-UNREGISTERED-KEY) probe_m6 ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  *) usage >&2; exit 2 ;;
esac
